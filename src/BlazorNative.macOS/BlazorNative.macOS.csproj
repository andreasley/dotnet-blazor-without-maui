<!-- The Razor SDK is used (like MAUI Blazor apps do) so that static web assets are resolved; see BlazorNative.WebKit.targets. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Native macOS (AppKit) application. Shows the shared Blazor UI in an NSWindow. -->
  <PropertyGroup>
    <TargetFramework>net11.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BlazorNative.MacOS</RootNamespace>
    <AssemblyName>BlazorNative</AssemblyName>
    <ApplicationId>com.yourcompany.blazornative</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

    <!--
      Trimming: keep the default (partial / SDK-only). Blazor's router discovers page components by
      reflection, so an aggressive "full" trim would need TrimmerRootAssembly entries for the UI assembly.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BlazorNative.Shared/BlazorNative.Shared.csproj" />
    <ProjectReference Include="../BlazorNative.WebKit/BlazorNative.WebKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!-- Bundles wwwroot/, _content/ of referenced Razor Class Libraries and _framework/blazor.webview.js into the app. -->
  <Import Project="../BlazorNative.WebKit/build/BlazorNative.WebKit.targets" />

</Project>
